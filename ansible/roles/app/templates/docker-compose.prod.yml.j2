# Hoard on the app VM. Images come from ACR by tag; the database is Azure PostgreSQL.
name: hoard

services:
  # One-off job: the playbook runs it before starting the app, so `up` skips it.
  migrate:
    image: "{{ acr_login_server }}/hoard-migrate:{{ image_tag }}"
    profiles: [tools]
    command: ["sh", "-c", "npx prisma migrate deploy && npm run db:seed"]
    environment:
      DATABASE_URL: ${DATABASE_URL}
      JWT_SECRET: ${JWT_SECRET}
      ADMIN_EMAIL: "{{ admin_email }}"
      ADMIN_NAME: "{{ admin_name }}"
      ADMIN_PASSWORD: ${ADMIN_PASSWORD}
    restart: "no"
    networks:
      - backend

  api:
    image: "{{ acr_login_server }}/hoard-api:{{ image_tag }}"
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "4000"
      DATABASE_URL: ${DATABASE_URL}
      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRES_IN: 1d
      CLIENT_ORIGIN: "{{ app_url }}"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4000/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
      - frontend

  web:
    image: "{{ acr_login_server }}/hoard-web:{{ image_tag }}"
    restart: unless-stopped
    ports:
      # nginx in the image listens on 8080. The load balancer sends port 80.
      - "80:8080"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 5s
    depends_on:
      api:
        condition: service_healthy
    networks:
      - frontend

networks:
  backend:
  frontend:

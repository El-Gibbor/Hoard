# Copy to .env and adjust for local development
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Local Postgres started with docker compose
DATABASE_URL=postgresql://hoard:hoard@127.0.0.1:5433/hoard
# Used only by the seed script. Replace the password before seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Hoard Admin
ADMIN_PASSWORD=change-me
# Secret used to sign login tokens. Use at least 32 characters.
JWT_SECRET=replace-with-a-local-secret-32-chars
JWT_EXPIRES_IN=1d

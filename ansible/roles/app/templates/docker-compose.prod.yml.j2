# Hoard on the virtual machine. The API and the web app are pulled by tag.
name: hoard

services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: hoard
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: hoard
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hoard -d hoard"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - backend

  # One-off job: the playbook runs it before starting the app, so `up` skips it.
  migrate:
    image: "ghcr.io/el-gibbor/hoard-migrate:{{ image_tag }}"
    profiles: [tools]
    command: ["sh", "-c", "npx prisma migrate deploy && npm run db:seed"]
    environment:
      DATABASE_URL: postgresql://hoard:${POSTGRES_PASSWORD}@db:5432/hoard
      JWT_SECRET: ${JWT_SECRET}
      ADMIN_EMAIL: "{{ admin_email }}"
      ADMIN_NAME: "{{ admin_name }}"
      ADMIN_PASSWORD: ${ADMIN_PASSWORD}
    depends_on:
      db:
        condition: service_healthy
    restart: "no"
    networks:
      - backend

  api:
    image: "ghcr.io/el-gibbor/hoard-api:{{ image_tag }}"
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "4000"
      DATABASE_URL: postgresql://hoard:${POSTGRES_PASSWORD}@db:5432/hoard
      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRES_IN: 1d
      CLIENT_ORIGIN: "http://{{ ansible_host }}"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4000/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    depends_on:
      db:
        condition: service_healthy
    networks:
      - backend
      - frontend

  web:
    image: "ghcr.io/el-gibbor/hoard-web:{{ image_tag }}"
    restart: unless-stopped
    ports:
      # nginx in the image listens on 8080. The browser uses port 80.
      - "80:8080"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 5s
    depends_on:
      api:
        condition: service_healthy
    networks:
      - frontend

networks:
  backend:
  frontend:

volumes:
  pgdata:

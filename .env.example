# Optional overrides for `docker compose up`. Copy to .env and change what you need.
# Every value below is a local-development default; never reuse these outside your machine.

# Database created in the db container
POSTGRES_USER=hoard
POSTGRES_PASSWORD=hoard
POSTGRES_DB=hoard

# Host ports for the app (web), the API and Postgres
WEB_PORT=8080
API_PORT=4000
POSTGRES_PORT=5433

# Secret used to sign login tokens. Use at least 32 characters.
JWT_SECRET=local-dev-jwt-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=1d

# Admin account created by the seed on first start
ADMIN_EMAIL=admin@hoard.local
ADMIN_NAME=Hoard Admin
ADMIN_PASSWORD=change-me-locally
